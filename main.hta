<htnl>
<head>
    <hta:application border="thin" caption="true" scroll="no">
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <meta charset="utf-8">

    <title>Excel aus hta</title>
</head>
<body>
    <h1>Excel wir geöffnet</h1>

    <script>
        var excel = new ActiveXObject("Excel.Application");

        excel.Visible = true;
        excel.Workbooks.Add();  
    </script>
</body>
</html>
