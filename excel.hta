
<hta:application border="thin" caption="yes" scroll="no">
<meta http-equiv="X-UA-Compatible" content="IE=11">

<title>Meine erste App</title>

<style>
html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    background: #202030;
}

.container {
    display: flex;
    justify-content: center;
    align-items: center;
}

.card {
    width: 100px;
    height: 80px;
    margin: 5px;
    color: white;
    background: #3498db;
    text-align: center;
    line-height: 80px;
}	
</style>

<body>
    <div class="container">
        <div class="card">Eins</div>
        <div class="card">Zwei</div>
        <div class="card">Drei</div>
    </div>
</body>

<script>
function createExcel() {
    var excel = new ActiveXObject("Excel.Application");

    excel.Visible = true;

    var workbook = excel.Workbooks.Add();
    var sheet = workbook.Worksheets(1);

    sheet.Cells(1, 1).Value = "Name";
    sheet.Cells(1, 2).Value = "Punkte";

    sheet.Cells(2, 1).Value = "Maik";
    sheet.Cells(2, 2).Value = 1234;

    sheet.Cells(3, 1).Value = "Balloon";
    sheet.Cells(3, 2).Value = 9001;

    sheet.Cells(4, 1).Value = "Summe";
    sheet.Cells(4, 2).Formula = "=SUM(B2:B3)";

    sheet.Columns("A:B").AutoFit();
}
createExcel();
</script>
